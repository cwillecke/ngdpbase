<%#
  The state of a shipped item's copy on this site (#1918, #2389): the words and
  badges of Admin -> Required Pages, shared by every admin screen that syncs
  shipped content (required pages, add-on pages). The state comes from
  shippedPageState (src/utils/addonPageSync.ts).

  locals: syncItem, one object (an include also sees its parent's data, so a
  loose name could be picked up from the screen by accident), with:
    status      'new' | 'modified' | 'current'
    syncState   'same-as-shipped' | 'update-ready' | 'edited-not-confirmed' |
                'both-changed'; absent for a page that is not on the site yet
%>
<% if (syncItem.status === 'new') { %>
<span class="badge bg-primary" data-sync-status="new">New</span>
<% } else if (syncItem.syncState === 'update-ready') { %>
<span class="badge bg-warning text-dark" data-sync-status="update-ready"
      title="A newer version came with this release. This page has not been changed on this site.">Update ready</span>
<% } else if (syncItem.syncState === 'edited-not-confirmed') { %>
<span class="badge bg-secondary" data-sync-status="edited-not-confirmed"
      title="This page was changed on this site. Sync All does not replace it.">
    <i class="fas fa-user-edit me-1"></i>Edited here, not confirmed
</span>
<% } else if (syncItem.syncState === 'both-changed') { %>
<span class="badge bg-danger" data-sync-status="both-changed"
      title="This page was changed on this site, and a newer version also shipped. Sync All does not replace it.">
    <i class="fas fa-user-edit me-1"></i>Edited here, and a newer version is available
</span>
<% } else { %>
<span class="badge bg-success" data-sync-status="same-as-shipped">Same as shipped</span>
<% } %>
